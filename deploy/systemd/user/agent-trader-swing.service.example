[Unit]
Description=agent-trader swing book (broker selected by the rules file)
# Example only. Do not enable this while a schwab-swing unit owns the same account.

[Service]
Type=simple
WorkingDirectory=%h/projects/schwabinvestbot
ExecStart=%h/.cargo/bin/agent-trader-swing tick --rules rules/trader-rules.example.yaml --trust --yes
Environment=AGENT_TRADER_LEGACY_RULES_DIR=%h/projects/schwabinvestbot/rules
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
