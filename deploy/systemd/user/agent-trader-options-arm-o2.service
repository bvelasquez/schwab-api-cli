# Cutover unit for options o2. Same rules file and paper state as
# schwab-options-arm-o2.service. Do not enable this while that unit is active.
# Paper only: never add --trust or --yes.

[Unit]
Description=Agent-trader options paper o2 (same loop as schwab agent run)
Documentation=file://%h/projects/schwabinvestbot/docs/REMOTE_PAPER_HOST.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/schwabinvestbot
Environment=SCHWAB_REPO=%h/projects/schwabinvestbot
ExecStart=%h/.cargo/bin/agent-trader --simulate options run --rules rules/options-arm-o2.yaml
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
