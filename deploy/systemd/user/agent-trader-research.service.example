# Research-paper arm (Public quotes, local fills, zero orders).
# Paper only: never add --trust or --yes; the research path rejects them.
#
# Copy rules/research/example-megacaps.yaml to rules/research/megacaps.yaml, put
# your real `public:<account id>` in it, and point ExecStart at that file.
#
# Env file (%h/.config/agent-trader/research.env) needs:
#   PUBLIC_API_KEY=...        (read-only use)
#   OPENROUTER_API_KEY=...    (forecast + web search)
# Keep PUBLIC_PERSONAL_SECRET unset: its presence fails the startup gate.
#
# Type=simple: one long-lived loop. Prefer this for a wide universe, because the
# in-process bar cache keeps a 40-name cross-section from costing one daily-bar
# request per symbol per tick. For a handful of symbols you can instead use
# Type=oneshot with `research tick` driven by agent-trader-research.timer.example
# (do not run both).
#
# Patches: proposals are always versioned. --apply-patches lets the arm trade the
# newest accepted bounded patch on the following tick (self-adaptation). Remove it
# to keep the arm propose-only. Only the fields in the arm's allowlist can change,
# and each is clamped to a hard rail.

[Unit]
Description=agent-trader research arm (paper-only; never places an order)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/schwabinvestbot
EnvironmentFile=%h/.config/agent-trader/research.env
ExecStart=%h/.cargo/bin/agent-trader research run --rules %h/projects/schwabinvestbot/rules/research/megacaps.yaml --interval-seconds 1800 --apply-patches
Restart=on-failure
RestartSec=60

[Install]
WantedBy=default.target
