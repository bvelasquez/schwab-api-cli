# Weekday morning brief (Pacific). Adjust OnCalendar for your timezone / preference.
# Runs after US cash open so "today" journal includes the opening session.

[Unit]
Description=Schwab paper morning review timer

[Timer]
OnCalendar=Mon..Fri *-*-* 07:30:00 America/Los_Angeles
Persistent=true
Unit=schwab-morning-review.service

[Install]
WantedBy=timers.target
