# A human reply is required now (Barry texts back the 2FA code over Telegram),
# so this only needs to run once a day plus an extra check before the Sunday
# evening/Monday premarket window. schwab-auto-login.py's own decision logic
# (refresh token remaining < 36h, or unknown-and-6-days-since-last-success)
# makes every other day a silent no-op — no browser, no Telegram prompt.

[Unit]
Description=Run the Schwab headless OAuth re-login check daily

[Timer]
OnCalendar=*-*-* 08:00:00 America/Los_Angeles
OnCalendar=Sun *-*-* 17:00:00 America/Los_Angeles
Persistent=true
Unit=schwab-auto-login.service

[Install]
WantedBy=timers.target
