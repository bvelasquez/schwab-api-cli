# A human reply is required (Barry texts back the 2FA code over Telegram).
# Weekend runs re-login whenever the token wouldn't outlive the coming trading
# week, so Mon–Fri never needs a prompt; four weekend slots (Sat 08/15, Sun
# 09/17) give retries while respecting the 6h backoff and 2-per-24h cap.
# Weekdays keep the < 36h safety net. Every other run is a silent no-op.

[Unit]
Description=Run the Schwab headless OAuth re-login check daily

[Timer]
OnCalendar=*-*-* 08:00:00 America/Los_Angeles
OnCalendar=Sat *-*-* 15:00:00 America/Los_Angeles
OnCalendar=Sun *-*-* 09:00:00 America/Los_Angeles
OnCalendar=Sun *-*-* 17:00:00 America/Los_Angeles
Persistent=true
Unit=schwab-auto-login.service

[Install]
WantedBy=timers.target
