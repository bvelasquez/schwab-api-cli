# Cutover unit for the 9947 swing book. Same rules file and paper state as
# schwab-swing-9947. Do not enable this while that unit is active.
# Paper only: never add --trust or --yes.
#
# If the live rules path differs, override ExecStart in a drop-in. Do not commit
# the live rules file.

[Unit]
Description=Agent-trader swing paper book 9947 (same loop as schwab-trader agent run)
Documentation=file://%h/projects/schwabinvestbot/docs/REMOTE_PAPER_HOST.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/schwabinvestbot
Environment=SCHWAB_REPO=%h/projects/schwabinvestbot
ExecStart=%h/.cargo/bin/agent-trader-swing --simulate book --rules rules/trader-swing-9947.yaml
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
